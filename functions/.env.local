APP_ENV=dev
MIN_INSTANCES=0
ENFORCE_APP_CHECK=false
ENABLE_TEST_ERROR=true
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1
MIN_INSTANCES_SIGNIN=0
WHATSAPP_PROVIDER=fake
OTP_MAX_SENDS_PER_IP=60
CLIENT_IP_HOP=1
ADMIN_SEARCH_LIMIT=30
# ID check (Prompt 3): fake in dev/staging; prod must not use fake (refused at startup).
KYC_PROVIDER=fake
VALIFY_ENABLED=false
# Invite links (Prompt 6): emulator default.
INVITE_LINK_BASE=https://demo-school-carpool-links.web.app
# Chat: our own chat on Firestore ("firestore" everywhere; "fake" only
# records calls and is refused in prod). No key and no secret. SETUP.md 19.
CHAT_PROVIDER=firestore
CHAT_MESSAGES_PER_MINUTE=30
CHAT_PHOTOS_PER_DAY=50
CHAT_MUTE_MINUTES=10
