rules_version = '2';

// DENY EVERYTHING (Prompt 1). Each later prompt opens exactly the reads and
// writes its feature needs, with emulator tests in tests/rules.
// The app never writes status, role, verification, schedule ownership,
// balances or transfers: Cloud Functions do (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
