APP_ENV=prod
MIN_INSTANCES=0
ENFORCE_APP_CHECK=true
ENABLE_TEST_ERROR=false
SENTRY_DSN=
SENTRY_SAMPLE_RATE=0.5
MIN_INSTANCES_SIGNIN=0
WHATSAPP_PROVIDER=meta
# Fill in from Meta WhatsApp Manager before the first prod deploy.
WHATSAPP_PHONE_NUMBER_ID=none
WHATSAPP_CODE_TEMPLATE=login_code
OTP_MAX_SENDS_PER_IP=60
CLIENT_IP_HOP=1
ADMIN_SEARCH_LIMIT=30
# ID check (Prompt 3): fake in dev/staging; prod must not use fake (refused at startup).
KYC_PROVIDER=valify
VALIFY_ENABLED=false
# Invite links (Prompt 6, F31): the links Hosting site of this project (SETUP.md 16).
INVITE_LINK_BASE=https://REPLACE-school-carpool-prod-links.web.app
# Chat (Prompt 9): the PROD Stream app (separate from dev). SETUP.md 19.
CHAT_PROVIDER=stream
STREAM_API_KEY=REPLACE-prod-stream-key
CHAT_RETENTION_DAYS=180

# Every other setting, written out because a non-interactive deploy needs
# a value for each one (defaults from functions/src/config.ts).
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_TEMPLATE_LANG_EN=en
VALIFY_BASE_URL=
VALIFY_USERNAME=
VALIFY_CLIENT_ID=
VALIFY_BUNDLE_KEY=
OTP_MAX_FAILURES_PER_DAY=30
SCHOOL_SEARCH_PROVIDER=fake
ALGOLIA_APP_ID=
ALGOLIA_INDEX=schools
MAP_HOME_MOVES_PER_DAY=4
MAP_NEARBY_SEARCHES_PER_HOUR=30
MAP_PLACE_SEARCHES_PER_HOUR=60
MAP_PLACE_DETAILS_PER_HOUR=20
MAP_DRIVING_SCHOOL_CHANGES_PER_DAY=3
PLACES_PROVIDER=google
CARPOOL_CREATES_PER_DAY=3
CARPOOL_SEARCHES_PER_HOUR=30
CARPOOL_JOIN_REQUESTS_PER_DAY=10
CARPOOL_INVITES_PER_DAY=20
CARPOOL_INVITE_OPENS_PER_HOUR=20
CARPOOL_WANTED_SAVES_PER_DAY=5
CARPOOL_WANTED_LISTS_PER_HOUR=30
SCHEDULE_CONFIRM_BY=21:00
SCHEDULE_LATE_LEAD_MIN=60
SCHEDULE_PLANS_PER_DAY=20
SCHEDULE_CHANGES_PER_DAY=100
PUSH_PROVIDER=fcm
NOTIFY_ALARM_DELAY_MIN=15
REMINDER_EVENING_AT=19:00
NOTIFY_DEVICE_CHANGES_PER_DAY=30
NOTIFY_SETTINGS_CHANGES_PER_DAY=100
CHAT_TOKEN_TTL_MIN=60
CHAT_TOKENS_PER_HOUR=30
CHAT_REQUESTS_PER_DAY=10
CHAT_REPORTS_PER_DAY=20
CHAT_CHANGES_PER_DAY=100
ROUTES_PROVIDER=google
ROUTES_TRAFFIC=true
TRIP_STALE_SEC=120
TRIP_SELFIE_PERCENT=20
TRIP_HANDOVER_MIN=10
WALLET_PROVIDER=fake
WALLET_PARTNER_ENABLED=false
MIN_INSTANCES_WALLET=0
TRUST_RATE_WINDOW_DAYS=30
SCHOOL_YEAR_START=09-01
YEAR_CHECK_OPEN_DAYS=21
YEAR_CHECK_GRACE_DAYS=14
YEAR_CHECK_FIRST_YEAR=2027
LICENCE_REMINDER_DAYS=30,7,1
# Settle up by InstaPay (F45): limits per parent. The largest amount of one
# record is the server setting config/settleUp.maxAmount (piastres).
SETTLE_UP_REQUESTS_PER_DAY=20
SETTLE_UP_CHANGES_PER_DAY=100
SETTLE_UP_ADDRESS_CHANGES_PER_DAY=5
SETTLE_UP_ADDRESS_VIEWS_PER_HOUR=30
SETTLE_UP_REPORT_AFTER=2
