# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
.idea/
.vscode/*
!.vscode/extensions.json
.metadata
pubspec_overrides.yaml

# Generated localizations (created by `flutter gen-l10n` in tool/bootstrap.sh)
lib/l10n/gen/

# Golden test failure output
**/failures/*.png

# --- Native folders are generated by `flutter create` in tool/bootstrap.sh ---
# Our overrides live in tool/ios and are applied by the script.
/ios/
/android/
/web/
/macos/
/linux/
/windows/

# --- Secrets: never commit ---
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
key.properties
GoogleService-Info.plist
google-services.json
service-account*.json
dart_defines/*.json
!dart_defines/*.example.json
.env
.env.*
!.env.example
# Functions params per project: non-secret flags only (see functions/.env.example)
!functions/.env.local
!functions/.env.dev
!functions/.env.staging
!functions/.env.prod

# --- Node / Firebase ---
node_modules/
functions/lib/
tests/rules/lib/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
.firebase/
emulator-data/

# --- OS ---
.DS_Store
Thumbs.db

# Schools downloads (also covered by data/schools/.gitignore)
data/schools/osm/
data/schools/boundaries/

# Python bytecode (tool/patch_native.py)
__pycache__/
*.pyc

# Generated screenshots (test/screenshots, uploaded by CI as an artifact)
test/screenshots/goldens/

# Local emulator secrets (see functions/.secret.local.example)
functions/.secret.local
