APP_ENV=prod
MIN_INSTANCES=0
ENFORCE_APP_CHECK=true
ENABLE_TEST_ERROR=false
SENTRY_DSN=
SENTRY_SAMPLE_RATE=0.5
MIN_INSTANCES_SIGNIN=0
WHATSAPP_PROVIDER=meta
# Fill in from Meta WhatsApp Manager before the first prod deploy.
WHATSAPP_PHONE_NUMBER_ID=none
WHATSAPP_CODE_TEMPLATE=login_code
OTP_MAX_SENDS_PER_IP=60
CLIENT_IP_HOP=1
ADMIN_SEARCH_LIMIT=30
# ID check (Prompt 3): fake in dev/staging; prod must not use fake (refused at startup).
KYC_PROVIDER=valify
VALIFY_ENABLED=false
# Invite links (Prompt 6, F31): the links Hosting site of this project (SETUP.md 16).
INVITE_LINK_BASE=https://REPLACE-school-carpool-prod-links.web.app
# Chat (Prompt 9): the PROD Stream app (separate from dev). SETUP.md 19.
CHAT_PROVIDER=stream
STREAM_API_KEY=REPLACE-prod-stream-key
CHAT_RETENTION_DAYS=180
