# Parameters read by Cloud Functions (firebase-functions/params).
# Firebase loads functions/.env.<alias> on deploy and functions/.env.local in
# the emulator. None of these are secrets: real secrets (WhatsApp, Stream,
# Algolia, Valify, wallet) go to Secret Manager via defineSecret() later.

# "dev" | "staging" | "prod"; sent to Sentry as the environment.
APP_ENV=dev
# COST MODE: 0 = no warm instances (free). Raise for sign-in, alerts and the
# wallet only when cold starts hurt (docs/COSTS.md).
MIN_INSTANCES=0
# App Check on callable functions. true in staging and prod.
ENFORCE_APP_CHECK=true
# Dev/staging only: allow the debugTestError callable.
ENABLE_TEST_ERROR=false
# Sentry DSN for Cloud Functions (a public client key per Sentry's docs).
# Empty = Sentry off.
SENTRY_DSN=
# Share of errors sent to Sentry (free Developer plan).
SENTRY_SAMPLE_RATE=1
# Warm instances for requestCode/verifyCode. COST MODE: 0.
MIN_INSTANCES_SIGNIN=0
# WhatsApp sender: "fake" prints sign-in codes to the function log (dev,
# staging; refused in prod), "meta" calls the WhatsApp Cloud API.
WHATSAPP_PROVIDER=fake
# Meta settings (not secrets). The access token is the WHATSAPP_ACCESS_TOKEN
# secret and the hash key is the OTP_HMAC_KEY secret (Secret Manager).
WHATSAPP_PHONE_NUMBER_ID=none
WHATSAPP_API_VERSION=v25.0
WHATSAPP_CODE_TEMPLATE=login_code
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_TEMPLATE_LANG_EN=en
