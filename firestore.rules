rules_version = '2';

// DENY BY DEFAULT. Each prompt opens exactly the reads and writes its
// feature needs, with emulator tests in tests/rules.
// The app never writes status, role, verification, parent ID, schedule
// ownership, balances or transfers: Cloud Functions do (the Admin SDK
// bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Prompt 12 (spec section 7). Set and cleared only by Cloud Functions
    // on users/{uid}:
    // - sessionsValidAfter (seconds): written when phones are signed out
    //   (signOutDevice, a sign-in from a new phone). A token from a sign-in
    //   before it is refused at once, not when it expires (up to 1 hour).
    // - newDeviceCheck.required: after a sign-in from a new phone, child,
    //   carpool, schedule, trip and location data stay closed until the
    //   fresh selfie matched (SIM swap: a stolen number alone opens none of
    //   it). The callables check the same two fields (device_gate.ts).
    // A signed-in parent always has the record (verifyCode creates it
    // before the sign-in token); no record means nothing to check.
    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasUserRecord() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function sessionValid() {
      return signedIn()
        && (!hasUserRecord()
          || !('sessionsValidAfter' in userRecord())
          || (request.auth.token.auth_time is int
            && request.auth.token.auth_time >= userRecord().sessionsValidAfter));
    }
    function deviceChecked() {
      return sessionValid()
        && (!hasUserRecord()
          || !('newDeviceCheck' in userRecord())
          || userRecord().newDeviceCheck == null
          || userRecord().newDeviceCheck.required != true);
    }

    // Prompt 4 (F14): an admin of the panel. The "admin" custom claim is
    // set only by a super admin (createAdmin function) or the bootstrap
    // script; the sign-in used a second factor (TOTP); the sign-in is less
    // than 8 hours old (keep in sync with ADMIN_SESSION_MAX_SECONDS in
    // functions/src/admin_panel/guard.ts); and the admin's record exists,
    // is not disabled, and the token was issued after any revocation (so a
    // disabled admin loses access at once, not when the token expires).
    // Parents never have the claim.
    function adminRecordAllows() {
      let record = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return record.disabled != true
        && (!('revokedAt' in record)
          || timestamp.value(request.auth.token.iat * 1000) > record.revokedAt);
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && 'sign_in_second_factor' in request.auth.token.firebase
        && request.auth.token.auth_time is int
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminRecordAllows()
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(8, 'h');
    }

    // Prompt 2 (F1, F44): the parent's own record. Created only by the
    // verifyCode function (status "unverified" and the parent ID). The
    // parent can read it and change only the app language.
    match /users/{uid} {
      allow get: if isSelf(uid) && sessionValid();
      allow update: if isSelf(uid) && sessionValid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language'])
        && request.resource.data.language in ['ar', 'en'];

      // Consent records: written only by the acceptConsents function,
      // readable by their owner (privacy screen later).
      match /consents/{consentId} {
        allow read: if isSelf(uid) && sessionValid();
      }

      // Prompt 8 (F12, F23): the parent's in-app notifications, written
      // only by the sender function (one per event). The parent reads
      // their own (at most 100 at a time) and may only mark one read: set
      // readAt, once, to the server time. Nothing else changes; nobody
      // creates or deletes one from the app.
      match /notifications/{notificationId} {
        // Texts name children and runs: closed during a new-phone check.
        allow get: if isSelf(uid) && deviceChecked();
        allow list: if isSelf(uid) && deviceChecked() && request.query.limit <= 100;
        allow update: if isSelf(uid) && deviceChecked()
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }
    }

    // Prompt 8: WhatsApp on or off per group and quiet hours. The parent
    // reads their own; only updateNotificationSettings writes it.
    match /notificationSettings/{uid} {
      allow get: if isSelf(uid) && sessionValid();
      allow list, create, update, delete: if false;
    }
    // Prompt 8: the notification outbox (every producer writes here, the
    // one sender reads it), push tokens and limits. Cloud Functions only.
    match /notificationEvents/{id} {
      allow read, write: if false;
    }
    match /pushTokens/{key} {
      allow read, write: if false;
    }
    match /notificationLimits/{uid} {
      allow read, write: if false;
    }

    // Prompt 3 (F3): children. Created, changed and removed only by Cloud
    // Functions (submitVerification, decideVerification, removeChild). A
    // parent reads only their own children; the app must query with
    // where('ownerUid', '==', uid).
    // Prompt 12: closed during a new-phone check (deviceChecked above).
    match /children/{childId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid && deviceChecked();
    }

    // Prompt 3 (F2): the driver's car, one per parent for now. Written only
    // by Cloud Functions; readable by its owner.
    match /vehicles/{uid} {
      allow get: if isSelf(uid) && sessionValid();
    }

    // Prompt 3 (F2, F18): verification cases, national ID hashes, the ban
    // list, server settings (config/kyc) and the audit log. Cloud Functions
    // only: admins see cases through the admin functions (signed image
    // links, every view logged), never by direct reads.
    match /verifications/{caseId} {
      allow read, write: if false;
    }
    match /nationalIds/{hash} {
      allow read, write: if false;
    }
    match /bannedIds/{hash} {
      allow read, write: if false;
    }
    match /config/{name} {
      allow read, write: if false;
    }
    // Audit log (Prompt 3, Prompt 4): written only by Cloud Functions.
    // Admins signed in with two steps may read it; nobody edits or deletes
    // an entry, admins included.
    match /auditLog/{entryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Prompt 4 (F14): admin accounts, search limits, moderation records
    // (with the admin's note) and the reports queue. Cloud Functions only;
    // the panel reads them through the admin functions.
    match /admins/{uid} {
      allow read, write: if false;
    }
    match /adminLimits/{uid} {
      allow read, write: if false;
    }
    match /moderations/{id} {
      allow read, write: if false;
    }
    match /reports/{id} {
      allow read, write: if false;
    }

    // Prompt 4B (F4): the schools list. Written only by Cloud Functions
    // (import script, admin panel, addOtherSchool). A signed-in user reads
    // active schools (public school names and places; queries at most 200
    // at a time) and only their OWN school typed under "Other" while it
    // awaits review. Merged schools and other parents' pending schools
    // stay hidden. Approving a school removes the parent's uid from it.
    function schoolVisible() {
      return resource.data.status == 'active'
        || (resource.data.status == 'awaiting_review' && resource.data.addedBy == request.auth.uid);
    }
    match /schools/{id} {
      allow get: if signedIn() && schoolVisible();
      allow list: if signedIn() && request.query.limit <= 200 && schoolVisible();
      allow create, update, delete: if false;
    }
    // Prompt 4B (F4): school search keys issued per parent per day.
    // Cloud Functions only.
    match /searchKeyLimits/{uid} {
      allow read, write: if false;
    }
    // Prompt 6: areas of a school (name and centre, public data managed by
    // admins). Signed-in parents read them to pick a carpool's area; at
    // most 200 at a time. Written only by Cloud Functions (admin panel).
    match /areas/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 200;
      allow create, update, delete: if false;
    }

    // Prompt 5 (F21 to F24): homes and maps.
    // The parent's EXACT home and map settings. Only the owner reads it;
    // only the setHomeLocation, updateMapSettings and setDrivingSchools
    // functions write it. Nobody else, verified or not, can read it.
    match /homes/{uid} {
      allow get: if isSelf(uid) && deviceChecked();
      allow list, create, update, delete: if false;
    }
    // The public map record: rounded point (about 500 m), geohash of the
    // rounded point, first name and schools. Read only by Cloud Functions
    // (searchNearbyParents, which rate limits and offsets every point); the
    // app never reads it, not even the owner's.
    match /parentLocations/{uid} {
      allow read, write: if false;
    }
    // Prompt 5's "new parent nearby" events (since Prompt 8 they go to
    // notificationEvents; nothing writes here), map rate limits and the
    // address cache: Cloud Functions only.
    match /newParentEvents/{id} {
      allow read, write: if false;
    }
    match /mapLimits/{uid} {
      allow read, write: if false;
    }
    match /placeCache/{id} {
      allow read, write: if false;
    }

    // Prompt 6 (F5, F6, F26, F31, F32): carpools. Every write is a Cloud
    // Function (membership, ownership, status, consent, pickup points).
    function verifiedParent() {
      return signedIn() && request.auth.token.verified == true;
    }

    // memberships/{carpoolId}_{uid}: status requested, approved, declined
    // or left, and the role (admin or member). A parent reads only their
    // own (the app queries where('uid', '==', uid)). The rules below look
    // them up, checking that the fields match the document ID.
    // A parent may also get their OWN membership ID when it does not exist
    // (a carpool they are not in): the ID must end in "_<their uid>", so
    // nobody learns whether another parent is a member.
    match /memberships/{id} {
      allow get: if sessionValid()
        && id.matches('.+_' + request.auth.uid)
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid && sessionValid();
      allow create, update, delete: if false;
    }
    function approvedMember(carpoolId, uid) {
      let path = /databases/$(database)/documents/memberships/$(carpoolId + '_' + uid);
      return exists(path) && get(path).data.status == 'approved'
        && get(path).data.carpoolId == carpoolId && get(path).data.uid == uid;
    }
    function carpoolAdmin(carpoolId) {
      return verifiedParent() && deviceChecked()
        && approvedMember(carpoolId, request.auth.uid)
        && get(/databases/$(database)/documents/memberships/$(carpoolId + '_' + request.auth.uid)).data.role == 'admin';
    }

    // The public summary of a carpool (school, area, times, days, seats,
    // rules, contribution, the creator's first name, counts; no children,
    // no homes). Any verified parent may read one by its ID (search
    // results, invite links); nobody lists or queries the collection: search
    // goes through the rate-limited searchCarpools function.
    match /carpools/{carpoolId} {
      allow get: if verifiedParent();
      allow list, create, update, delete: if false;

      // Approved members with their children's first names and grades
      // (spec section 6): approved members of the same carpool only.
      match /members/{uid} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }

      // Open join requests with the children's first names and grades:
      // the requester and the carpool admin only.
      match /requests/{uid} {
        allow get: if (isSelf(uid) && verifiedParent() && deviceChecked()) || carpoolAdmin(carpoolId);
        allow list: if carpoolAdmin(carpoolId);
        allow create, update, delete: if false;
      }

      // F26: who accepted whom as a driver. Approved members only.
      match /driverConsents/{id} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }

      // EXACT pickup point a parent chose to share with one carpool
      // (setPickupSharing). Readable by its owner and by verified parents
      // who are approved members of the same carpool, while the owner is an
      // approved member too. Never by anyone else, never written by the app.
      match /pickupPoints/{uid} {
        allow get: if (isSelf(uid) && deviceChecked())
          || (verifiedParent()
            && deviceChecked()
            && approvedMember(carpoolId, request.auth.uid)
            && approvedMember(carpoolId, uid));
        allow list, create, update, delete: if false;
      }

      // Prompt 7 (F7, F11, F27, F28, F30, F37): the schedule. Runs with
      // their driver and pickup list (children's first names only), swap
      // requests, no-school days and time changes, and the term's drive
      // balance. Approved members of that carpool read them; only Cloud
      // Functions write them (the app never writes schedule ownership).
      match /schedule/{runId} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }
      match /swaps/{swapId} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }
      match /exceptions/{exceptionId} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }
      match /balances/{termId} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }

      // Prompt 10 (F20): emergency alerts with the driver's point, for every
      // approved member (the whole group is alerted). Deleted after 24 hours.
      match /emergencies/{emergencyId} {
        allow get, list: if verifiedParent() && deviceChecked() && approvedMember(carpoolId, request.auth.uid);
        allow create, update, delete: if false;
      }
    }

    // Prompt 10 (F15, F16, F33, F34, F41): trips. One per started run, with
    // the driver, the car, the stops (children's first names, states,
    // handover names) and `viewerUids`: the driver and the parents of the
    // children on THAT run. Only they read it; parents of other children,
    // other members and everyone else see nothing. The app never writes a
    // trip, a stop state or a point: Cloud Functions do (startTrip,
    // tripAction, tripLocation).
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function tripViewer(tripId) {
      return verifiedParent() && deviceChecked()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && request.auth.uid in tripData(tripId).viewerUids;
    }
    match /trips/{tripId} {
      // get and the app's query where('viewerUids', 'array-contains', uid).
      allow get, list: if verifiedParent() && deviceChecked() && request.auth.uid in resource.data.viewerUids;
      allow create, update, delete: if false;

      // Live points: the same people, and only while the run is tracked
      // (spec section 6: off outside runs). Deleted within 24 hours.
      match /points/{pointId} {
        allow get, list: if tripViewer(tripId) && tripData(tripId).status == 'active';
        allow create, update, delete: if false;
      }

      // Arrival time at one parent's stop: that parent and the driver.
      match /eta/{parentUid} {
        allow get: if tripViewer(tripId)
          && (isSelf(parentUid) || tripData(tripId).driverUid == request.auth.uid);
        allow list, create, update, delete: if false;
      }
    }

    // Exact stop points for the arrival times: Cloud Functions only.
    match /tripStops/{tripId} {
      allow read, write: if false;
    }
    // F38: the random selfie check of one run; its driver reads it.
    match /tripChecks/{tripId} {
      allow get: if verifiedParent() && deviceChecked() && resource.data.driverUid == request.auth.uid;
      allow list, create, update, delete: if false;
    }
    match /tripLimits/{uid} {
      allow read, write: if false;
    }
    // F29: adults allowed to receive a child; the child's parent reads the
    // list (with phone numbers); drivers get names and relations on the
    // trip. Written by saveHandoverAdults.
    match /handoverAdults/{childId} {
      allow get: if signedIn() && deviceChecked() && resource.data.ownerUid == request.auth.uid;
      allow list, create, update, delete: if false;
    }
    // F20: the parent's own emergency contact. Written by setEmergencyContact.
    match /emergencyContacts/{uid} {
      allow get: if isSelf(uid) && deviceChecked();
      allow list, create, update, delete: if false;
    }

    // Prompt 7's alert events. Since Prompt 8 they go to notificationEvents;
    // nothing writes here any more. Closed.
    match /scheduleEvents/{id} {
      allow read, write: if false;
    }

    // Invite codes (F31) and carpool rate limits: Cloud Functions only.
    match /carpoolInvites/{code} {
      allow read, write: if false;
    }
    match /carpoolLimits/{uid} {
      allow read, write: if false;
    }
    // "Looking for a carpool" posts (F32): the owner reads their own; other
    // parents see them only through listCarpoolWanted (same school, rate
    // limited, first names only).
    match /carpoolWanted/{uid} {
      allow get: if isSelf(uid) && deviceChecked();
      allow list, create, update, delete: if false;
    }

    // Chat (F8, F9, F10, F13): our own chat on Firestore. Cloud Functions
    // write every record of this first block. A verified parent reads
    // only their own: requests they sent or got (first names only),
    // parents they blocked, their mute choices and their settings. The
    // channel registry, group memberships, limits and chat push records
    // (users/{uid}/chatPushes) stay closed. Reports stay closed (admins
    // read them through functions).
    match /chatRequests/{id} {
      allow get: if verifiedParent() && deviceChecked()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if verifiedParent() && deviceChecked() && request.query.limit <= 50
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /chatBlocks/{id} {
      allow get: if verifiedParent() && deviceChecked() && resource.data.blockerUid == request.auth.uid;
      allow list: if verifiedParent() && deviceChecked() && request.query.limit <= 200 && resource.data.blockerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /chatMutes/{id} {
      allow get: if verifiedParent() && deviceChecked() && resource.data.uid == request.auth.uid;
      allow list: if verifiedParent() && deviceChecked() && request.query.limit <= 500 && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /chatSettings/{uid} {
      allow get: if isSelf(uid) && verifiedParent() && deviceChecked();
      allow list, create, update, delete: if false;
    }
    match /chatChannels/{cid} {
      allow read, write: if false;
    }
    match /chatMemberships/{uid} {
      allow read, write: if false;
    }
    match /chatLimits/{uid} {
      allow read, write: if false;
    }

    // Own chat: the documents the phone reads and writes
    // (functions/src/chat/data.ts).
    //
    // MEMBERSHIP is the member document chats/{cid}/chatMembers/{uid},
    // written only by Cloud Functions and read here on EVERY request: a
    // parent who was removed (active false), suspended, banned or deleted
    // (cut true) loses read and write at once, not when a token expires. A
    // frozen chat (block, closed carpool) and a parent who sent too fast
    // (mutedUntil in the future) can still read but not write.
    //
    // The kind of chat is the first part of its ID: only private and
    // carpool chats ("small" chats) take photos, the location pin, read
    // marks and typing; school and area groups are text only.
    function chatMemberPath(cid) {
      return /databases/$(database)/documents/chats/$(cid)/chatMembers/$(request.auth.uid);
    }
    function inChat(cid) {
      return verifiedParent() && deviceChecked()
        && exists(chatMemberPath(cid))
        && get(chatMemberPath(cid)).data.active == true
        && get(chatMemberPath(cid)).data.cut != true;
    }
    function notMuted(member) {
      return !('mutedUntil' in member) || member.mutedUntil == null || member.mutedUntil < request.time;
    }
    function canPost(cid) {
      return inChat(cid)
        && get(chatMemberPath(cid)).data.frozen != true
        && notMuted(get(chatMemberPath(cid)).data);
    }
    function smallChat(cid) {
      return cid.matches('cp_(private|carpool):[A-Za-z0-9_-]+');
    }
    function chatId(cid) {
      return cid.matches('cp_(private|school|area|carpool):[A-Za-z0-9_-]+');
    }
    // A message as the phone may create it: own uid, server time, one of
    // three kinds with exactly its fields. Text up to 2000 characters
    // (MESSAGE_TEXT_MAX). A photo names the file the sender uploaded under
    // chatPhotos/{type}/{id}/{uid}/{messageId} (storage.rules; the chat ID
    // with "/" in place of ":"). No other field.
    function validText(d) {
      return d.keys().hasOnly(['senderUid', 'kind', 'text', 'createdAt'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000;
    }
    function validPhoto(cid, messageId, d) {
      return smallChat(cid)
        && d.keys().hasOnly(['senderUid', 'kind', 'photoPath', 'createdAt'])
        && d.photoPath is string
        && (d.photoPath == 'chatPhotos/' + cid.replace(':', '/') + '/' + request.auth.uid + '/' + messageId + '.webp'
          || d.photoPath == 'chatPhotos/' + cid.replace(':', '/') + '/' + request.auth.uid + '/' + messageId + '.jpg');
    }
    function validPin(cid, d) {
      return smallChat(cid)
        && d.keys().hasOnly(['senderUid', 'kind', 'lat', 'lng', 'createdAt'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }
    function validMessage(cid, messageId) {
      let d = request.resource.data;
      return messageId.matches('[A-Za-z0-9_-]{8,64}')
        && d.keys().hasAll(['senderUid', 'kind', 'createdAt'])
        && d.senderUid == request.auth.uid
        && d.createdAt == request.time
        && ((d.kind == 'text' && validText(d))
          || (d.kind == 'photo' && validPhoto(cid, messageId, d))
          || (d.kind == 'location' && validPin(cid, d)));
    }
    // The parent's own read and typing times: each is left as it was,
    // cleared, or set to the server time.
    function ownStamp(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field] == request.time
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }
    match /chats/{cid} {
      // The head: names, member count, frozen, last message, counter.
      allow get: if chatId(cid) && inChat(cid);
      allow list, create, update, delete: if false;

      // First names of the members (for message authors). Functions only
      // write; members read one, or up to 50 at a time.
      match /chatMembers/{uid} {
        allow get: if inChat(cid);
        allow list: if inChat(cid) && request.query.limit <= 50;
        allow create, update, delete: if false;
      }
      // Messages: members read (at most 50 per query); the sender creates
      // their own; nobody edits or deletes from the app (admins remove
      // through functions).
      match /messages/{messageId} {
        allow get: if inChat(cid);
        allow list: if inChat(cid) && request.query.limit <= 50;
        allow create: if chatId(cid) && canPost(cid) && validMessage(cid, messageId);
        allow update, delete: if false;
      }
      // Read marks and typing, small chats only.
      match /reads/{uid} {
        allow get: if smallChat(cid) && inChat(cid);
        allow list: if smallChat(cid) && inChat(cid) && request.query.limit <= 50;
        allow create, update: if isSelf(uid) && smallChat(cid) && inChat(cid)
          && request.resource.data.keys().hasOnly(['readAt', 'typingAt'])
          && ownStamp('readAt') && ownStamp('typingAt');
        allow delete: if false;
      }
    }
    // The parent's chat list, one row per chat, written by Cloud Functions.
    // Only open rows are readable (a cut-off or removed parent's rows are
    // closed), so the app must query with where('open', '==', true). The
    // parent may only mark a chat read: unread back to 0, the read time
    // and the counter they read up to.
    match /userChats/{uid} {
      allow read, write: if false;
      match /summaries/{cid} {
        allow get: if isSelf(uid) && verifiedParent() && deviceChecked() && resource.data.open == true;
        allow list: if isSelf(uid) && verifiedParent() && deviceChecked() && request.query.limit <= 100
          && resource.data.open == true;
        allow update: if isSelf(uid) && verifiedParent() && deviceChecked() && resource.data.open == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'readSeq', 'readAt'])
          && request.resource.data.unread == 0
          && request.resource.data.readAt == request.time
          && request.resource.data.readSeq is int
          && request.resource.data.readSeq >= 0;
        allow create, delete: if false;
      }
    }

    // Prompt 11B (F43, F44): wallet. MONEY rules: the app never writes a
    // balance or a transfer, and reads its wallet only through the wallet
    // functions (balance from the partner, history from Cloud Functions).
    // Transfers and their results are append-only, written by Cloud
    // Functions alone; the fake partner's test money and the counters are
    // server records. Closed to everyone here, admins included (the admin
    // panel reads through functions and cannot move money).
    match /wallets/{uid} {
      allow read, write: if false;
    }
    match /transfers/{id} {
      allow read, write: if false;
    }
    match /transferResults/{id} {
      allow read, write: if false;
    }
    match /walletPending/{id} {
      allow read, write: if false;
    }
    match /walletDaily/{id} {
      allow read, write: if false;
    }
    match /walletLimits/{uid} {
      allow read, write: if false;
    }
    match /walletAlerts/{id} {
      allow read, write: if false;
    }
    match /fakeWalletAccounts/{ref} {
      allow read, write: if false;
    }
    match /fakeWalletOps/{id} {
      allow read, write: if false;
    }

    // Prompt 11 (F17): trust. Ratings (one per pair per month), their
    // summaries and flags, guardian link requests and links, and limits
    // are Cloud Functions only: the app reads and changes them through the
    // trust functions (trust/callables.ts), admins through the admin trust
    // functions. A linked parent does not read the child record directly.
    match /ratings/{id} {
      allow read, write: if false;
    }
    match /trustSummaries/{uid} {
      allow read, write: if false;
    }
    match /ratingFlags/{id} {
      allow read, write: if false;
    }
    match /guardianRequests/{id} {
      allow read, write: if false;
    }
    match /guardianLinks/{id} {
      allow read, write: if false;
    }
    match /trustLimits/{uid} {
      allow read, write: if false;
    }

    // Reserved parent IDs, sign-in codes and sign-in limits: Cloud
    // Functions only. Parent ID lookups (F44) go through the rate-limited
    // lookupParentId function (Prompt 11B), never a direct read.
    match /parentIds/{parentId} {
      allow read, write: if false;
    }
    match /otpCodes/{key} {
      allow read, write: if false;
    }
    match /otpLimits/{key} {
      allow read, write: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
