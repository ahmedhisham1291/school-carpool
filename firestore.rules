rules_version = '2';

// DENY BY DEFAULT. Each prompt opens exactly the reads and writes its
// feature needs, with emulator tests in tests/rules.
// The app never writes status, role, verification, parent ID, schedule
// ownership, balances or transfers: Cloud Functions do (the Admin SDK
// bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Prompt 4 (F14): an admin of the panel. The "admin" custom claim is
    // set only by a super admin (createAdmin function) or the bootstrap
    // script; the sign-in used a second factor (TOTP); the sign-in is less
    // than 8 hours old (keep in sync with ADMIN_SESSION_MAX_SECONDS in
    // functions/src/admin_panel/guard.ts); and the admin's record exists,
    // is not disabled, and the token was issued after any revocation (so a
    // disabled admin loses access at once, not when the token expires).
    // Parents never have the claim.
    function adminRecordAllows() {
      let record = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return record.disabled != true
        && (!('revokedAt' in record)
          || timestamp.value(request.auth.token.iat * 1000) > record.revokedAt);
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && 'sign_in_second_factor' in request.auth.token.firebase
        && request.auth.token.auth_time is int
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminRecordAllows()
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(8, 'h');
    }

    // Prompt 2 (F1, F44): the parent's own record. Created only by the
    // verifyCode function (status "unverified" and the parent ID). The
    // parent can read it and change only the app language.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language'])
        && request.resource.data.language in ['ar', 'en'];

      // Consent records: written only by the acceptConsents function,
      // readable by their owner (privacy screen later).
      match /consents/{consentId} {
        allow read: if isSelf(uid);
      }
    }

    // Prompt 3 (F3): children. Created, changed and removed only by Cloud
    // Functions (submitVerification, decideVerification, removeChild). A
    // parent reads only their own children; the app must query with
    // where('ownerUid', '==', uid).
    match /children/{childId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Prompt 3 (F2): the driver's car, one per parent for now. Written only
    // by Cloud Functions; readable by its owner.
    match /vehicles/{uid} {
      allow get: if isSelf(uid);
    }

    // Prompt 3 (F2, F18): verification cases, national ID hashes, the ban
    // list, server settings (config/kyc) and the audit log. Cloud Functions
    // only: admins see cases through the admin functions (signed image
    // links, every view logged), never by direct reads.
    match /verifications/{caseId} {
      allow read, write: if false;
    }
    match /nationalIds/{hash} {
      allow read, write: if false;
    }
    match /bannedIds/{hash} {
      allow read, write: if false;
    }
    match /config/{name} {
      allow read, write: if false;
    }
    // Audit log (Prompt 3, Prompt 4): written only by Cloud Functions.
    // Admins signed in with two steps may read it; nobody edits or deletes
    // an entry, admins included.
    match /auditLog/{entryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Prompt 4 (F14): admin accounts, search limits, moderation records
    // (with the admin's note) and the reports queue. Cloud Functions only;
    // the panel reads them through the admin functions.
    match /admins/{uid} {
      allow read, write: if false;
    }
    match /adminLimits/{uid} {
      allow read, write: if false;
    }
    match /moderations/{id} {
      allow read, write: if false;
    }
    match /reports/{id} {
      allow read, write: if false;
    }

    // Prompt 4B (F4): the schools list. Written only by Cloud Functions
    // (import script, admin panel, addOtherSchool). A signed-in user reads
    // active schools (public school names and places; queries at most 200
    // at a time) and only their OWN school typed under "Other" while it
    // awaits review. Merged schools and other parents' pending schools
    // stay hidden. Approving a school removes the parent's uid from it.
    function schoolVisible() {
      return resource.data.status == 'active'
        || (resource.data.status == 'awaiting_review' && resource.data.addedBy == request.auth.uid);
    }
    match /schools/{id} {
      allow get: if signedIn() && schoolVisible();
      allow list: if signedIn() && request.query.limit <= 200 && schoolVisible();
      allow create, update, delete: if false;
    }
    // Prompt 4B (F4): school search keys issued per parent per day.
    // Cloud Functions only.
    match /searchKeyLimits/{uid} {
      allow read, write: if false;
    }
    // Areas stay admin-only until carpools use them (Prompt 6).
    match /areas/{id} {
      allow read, write: if false;
    }

    // Prompt 5 (F21 to F24): homes and maps.
    // The parent's EXACT home and map settings. Only the owner reads it;
    // only the setHomeLocation, updateMapSettings and setDrivingSchools
    // functions write it. Nobody else, verified or not, can read it.
    match /homes/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }
    // The public map record: rounded point (about 500 m), geohash of the
    // rounded point, first name and schools. Read only by Cloud Functions
    // (searchNearbyParents, which rate limits and offsets every point); the
    // app never reads it, not even the owner's.
    match /parentLocations/{uid} {
      allow read, write: if false;
    }
    // "New parent nearby" events (sent in Prompt 8), map rate limits and
    // the address cache: Cloud Functions only.
    match /newParentEvents/{id} {
      allow read, write: if false;
    }
    match /mapLimits/{uid} {
      allow read, write: if false;
    }
    match /placeCache/{id} {
      allow read, write: if false;
    }

    // Carpool memberships (Prompt 6 creates them, Cloud Functions only):
    // memberships/{carpoolId}_{uid} with status requested, approved,
    // declined or left. Closed to the app for now; the rules below look
    // them up.
    match /memberships/{id} {
      allow read, write: if false;
    }
    function approvedMember(carpoolId, uid) {
      let path = /databases/$(database)/documents/memberships/$(carpoolId + '_' + uid);
      return exists(path) && get(path).data.status == 'approved'
        && get(path).data.carpoolId == carpoolId && get(path).data.uid == uid;
    }
    // Carpools themselves open in Prompt 6.
    match /carpools/{carpoolId} {
      allow read, write: if false;

      // EXACT pickup point a parent chose to share with one carpool
      // (Prompt 6 writes it through a function, only if the parent
      // chooses). Readable by its owner and by verified parents who are
      // approved members of the same carpool, while the owner is an
      // approved member too. Never by anyone else, never written by the app.
      match /pickupPoints/{uid} {
        allow get: if isSelf(uid)
          || (signedIn()
            && request.auth.token.verified == true
            && approvedMember(carpoolId, request.auth.uid)
            && approvedMember(carpoolId, uid));
        allow list, create, update, delete: if false;
      }
    }

    // Reserved parent IDs, sign-in codes and sign-in limits: Cloud
    // Functions only. Parent ID lookups (F44) will go through a
    // rate-limited function, never a direct read.
    match /parentIds/{parentId} {
      allow read, write: if false;
    }
    match /otpCodes/{key} {
      allow read, write: if false;
    }
    match /otpLimits/{key} {
      allow read, write: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
