rules_version = '2';

// DENY BY DEFAULT. Verification images live under verification/{uid}/:
//
//   pending/{name}           the parent's own uploads (Prompt 3, F2, F3)
//   cases/{caseId}/{name}    copied there by submitVerification; Cloud
//                            Functions only
//
// Nobody reads any of them through the client SDK, not even the owner or an
// admin. Admins see case images through the openVerificationCase function,
// which hands out 5-minute signed links and logs every view. Cloud
// Functions use the Admin SDK, which bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {

    // The parent uploads (and may replace, for a retake) a known document
    // name into their own pending folder: JPEG only, at most 3 MB (the app
    // compresses to well under that). School ID slots are c1 to c10
    // (MAX_CHILDREN), so the number of files per parent is bounded.
    // No reads, no deletes, no listing.
    match /verification/{uid}/pending/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && name.matches('(id_front|id_back|selfie|selfie_turn|license|car_license|driver_photo|school_id_c([1-9]|10))[.]jpg')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Prompt 10 (F38): the driver's live selfie for one run's check
    // ({tripId}.jpg). Upload only, by its owner; the submitSelfieCheck
    // function reads it, matches it and deletes it on every path, and
    // tripTick deletes any older than an hour. No reads.
    // faceRefs/{uid}/selfie.jpg (the identity selfie kept as the face
    // reference) is Cloud Functions only, like driverPhotos.
    // driverPhotos/{uid}/photo.jpg (the photo approved during verification)
    // is written and read by Cloud Functions only (15-minute signed links
    // for today's driver card).
    match /selfieChecks/{uid}/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.verified == true
        // Only a run's name: {carpoolId}_{YYYY-MM-DD}_{am|pm}.jpg.
        && name.matches('[A-Za-z0-9_-]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}_(am|pm)[.]jpg')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
