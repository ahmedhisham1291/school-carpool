rules_version = '2';

// DENY BY DEFAULT. Chat photos (chatPhotos/, members of that chat only) are
// near the end. Verification images live under verification/{uid}/:
//
//   pending/{name}           the parent's own uploads (Prompt 3, F2, F3)
//   cases/{caseId}/{name}    copied there by submitVerification; Cloud
//                            Functions only
//
// Nobody reads any of them through the client SDK, not even the owner or an
// admin. Admins see case images through the openVerificationCase function,
// which hands out 5-minute signed links and logs every view. Cloud
// Functions use the Admin SDK, which bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {

    // The parent uploads (and may replace, for a retake) a known document
    // name into their own pending folder: JPEG only, at most 3 MB (the app
    // compresses to well under that). School ID slots are c1 to c10
    // (MAX_CHILDREN), so the number of files per parent is bounded.
    // No reads, no deletes, no listing.
    match /verification/{uid}/pending/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && name.matches('(id_front|id_back|selfie|selfie_turn|license|car_license|driver_photo|school_id_c([1-9]|10))[.]jpg')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Prompt 10 (F38): the driver's live selfie for one run's check
    // ({tripId}.jpg). Upload only, by its owner; the submitSelfieCheck
    // function reads it, matches it and deletes it on every path, and
    // tripTick deletes any older than an hour. No reads.
    // faceRefs/{uid}/selfie.jpg (the identity selfie kept as the face
    // reference) is Cloud Functions only, like driverPhotos.
    // driverPhotos/{uid}/photo.jpg (the photo approved during verification)
    // is written and read by Cloud Functions only (15-minute signed links
    // for today's driver card).
    match /selfieChecks/{uid}/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.verified == true
        // Only a run's name: {carpoolId}_{YYYY-MM-DD}_{am|pm}.jpg.
        && name.matches('[A-Za-z0-9_-]{1,128}_[0-9]{4}-[0-9]{2}-[0-9]{2}_(am|pm)[.]jpg')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Prompt 11: the live selfie of a phone-number change (re-verification).
    // Upload only, by its verified owner, one fixed name; the
    // confirmPhoneChange function reads it, matches it to the face reference
    // and deletes it on every path. No reads.
    match /phoneChecks/{uid}/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.verified == true
        && name == 'selfie.jpg'
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Prompt 12: the fresh selfie after a sign-in from a new phone.
    // Upload only, by its verified owner, one fixed name; the
    // confirmNewDevice function matches it to the face reference and moves
    // it to the selfie archive (Cloud Functions only). No reads.
    // Everything else Prompt 12 adds is Cloud Functions only:
    // selfieArchive/{uid}, thumbs/{uid}, exports/{uid} (the app gets a
    // 1-hour signed link) and routeArchive/{year} (Coldline).
    match /deviceChecks/{uid}/{name} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.verified == true
        && name == 'selfie.jpg'
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Chat photos (own chat on Firestore):
    // chatPhotos/{type}/{id}/{uid}/{name}, where "type:id" is the chat's ID
    // in Firestore (the ":" is not used in a Storage path).
    // Only private and carpool chats have photos. Membership is the same
    // access document firestore.rules read, checked on every request
    // (firestore.get: Storage needs the "Firebase Rules Firestore Service
    // Agent" role, SETUP.md 19): a removed, suspended or blocked-out parent
    // can neither read nor upload at once. A member uploads only into
    // their own folder, once per name (no replace, no delete): WebP or
    // JPEG, at most 3 MB (the app re-encodes to far less and removes EXIF).
    // Cloud Functions delete (admin removal, retention).
    function chatMember(cid) {
      return firestore.get(/databases/(default)/documents/chats/$(cid)/chatAccess/$(request.auth.uid)).data;
    }
    function isChatMember(cid) {
      return firestore.exists(/databases/(default)/documents/chats/$(cid)/chatAccess/$(request.auth.uid))
        && chatMember(cid).active == true
        && chatMember(cid).cut != true;
    }
    // The same two checks firestore.rules make on users/{uid} (the second
    // of the two Firestore documents a Storage rule may read): a token from
    // before "sign out my phones" is refused at once, and nothing opens
    // during a new-phone check. A signed-in parent always has the record.
    function userRecord() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function sessionAndPhoneOk() {
      return !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        || sessionAndPhoneOkFor(userRecord());
    }
    function sessionAndPhoneOkFor(record) {
      return (!('sessionsValidAfter' in record)
          || (request.auth.token.auth_time is int
            && request.auth.token.auth_time >= record.sessionsValidAfter))
        && (!('newDeviceCheck' in record)
          || record.newDeviceCheck == null
          || record.newDeviceCheck.required != true);
    }
    function inChat(type, id) {
      return request.auth != null
        && 'verified' in request.auth.token
        && request.auth.token.verified == true
        && type.matches('cp_(private|carpool)')
        && id.matches('[A-Za-z0-9_-]+')
        && isChatMember(type + ':' + id)
        && sessionAndPhoneOk();
    }
    function mayPost(member) {
      return member.frozen != true
        && (!('mutedUntil' in member) || member.mutedUntil == null || member.mutedUntil < request.time);
    }
    match /chatPhotos/{type}/{id}/{uid}/{name} {
      allow get: if inChat(type, id);
      // "create" alone does not stop a second upload over the same name:
      // nothing may be there yet (resource == null).
      allow create: if inChat(type, id)
        && resource == null
        && request.auth.uid == uid
        && mayPost(chatMember(type + ':' + id))
        && name.matches('[A-Za-z0-9_-]{8,64}[.](webp|jpg)')
        && request.resource.size > 0
        && request.resource.size < 3 * 1024 * 1024
        && (request.resource.contentType == 'image/webp' || request.resource.contentType == 'image/jpeg');
      allow list, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
