# Copy to functions/.secret.local (git-ignored) to set secrets for the local
# emulators. Without it the emulator uses a built-in dev-only hash key, and
# the fake WhatsApp sender needs no token.
OTP_HMAC_KEY=any-long-random-string-for-local-testing
WHATSAPP_ACCESS_TOKEN=unused-with-the-fake-sender
# Chat (Prompt 9): only with CHAT_PROVIDER=stream in functions/.env.local,
# the DEV Stream app's secret (fake users only).
STREAM_API_SECRET=unused-with-the-fake-chat
